{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:create": "sequelize-cli db:create",
    "db:migrate": "sequelize-cli db:migrate",
    "db:seed": "sequelize-cli db:seed:all",
    "db:reset": "sequelize-cli db:migrate:undo:all && sequelize-cli db:migrate && sequelize-cli db:seed:all",
    "db:create:test": "cross-env NODE_ENV=test sequelize-cli db:create",
    "pretest": "cross-env NODE_ENV=test sequelize-cli db:migrate",
    "test": "cross-env NODE_ENV=test jest --runInBand"
  },
  "keywords": [],
